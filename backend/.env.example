# Copy to .env for local development. On Render these are set under
# Environment on the service; nothing here is read from a committed file.

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Render injects PORT and the app must bind whatever it is given. Only set this
# locally.
PORT=4000

# "production" switches request logging to combined format.
NODE_ENV=development

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# Absolute path to the SQLite file. Leave unset and it sits next to the source.
# Point it at a mounted disk to survive redeploys — requires a paid Render plan;
# on the free plan the filesystem is ephemeral and this should stay unset.
# PULSE_DB=/var/data/pulse.db

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Signs app session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Changing it signs every existing app session out.
JWT_SECRET=change-me-in-production

# First administrator for /admin. Setting ADMIN_PASSWORD also resets the owner
# password on the next boot, so it doubles as password recovery. Leave it unset
# and a random password is generated and printed once to the log.
ADMIN_EMAIL=admin@panchshil.com
# ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# OTP delivery
# ---------------------------------------------------------------------------

# console | msg91 | twilio
# "console" logs the code and returns it in the API response so the app can be
# used without a gateway. Any real provider stops that automatically.
SMS_PROVIDER=console

# Force-disable echoing even in console mode.
# PULSE_ECHO_OTP=false

# MSG91 — better rates for Indian numbers. Sender ID and template must be
# registered on a DLT platform before Indian carriers will deliver.
# MSG91_AUTH_KEY=
# MSG91_TEMPLATE_ID=
# MSG91_SENDER_ID=PULSE

# Twilio
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM=+15551234567

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated allowed origins. Unset means allow any, which is correct for
# a mobile client that authenticates with a bearer token rather than cookies.
# CORS_ORIGIN=https://admin.example.com
